{
  "name": "paradigma-cli",
  "version": "0.12.0",
  "description": "Paradigma CLI: lets your coding agent set up and operate Paradigma SEO/GEO monitoring, and runs Paradigma fixes in your own GitHub Actions.",
  "keywords": [
    "paradigma",
    "seo",
    "geo",
    "ai-search",
    "generative-engine-optimization",
    "search-console",
    "nextjs",
    "cli",
    "mcp",
    "ai-agents",
    "claude-code",
    "codex",
    "cursor"
  ],
  "homepage": "https://paradigma.click",
  "bugs": {
    "url": "https://github.com/Paradigma-click/paradigma-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Paradigma-click/paradigma-cli"
  },
  "license": "MIT",
  "author": "Paradigma <support@paradigma.click>",
  "type": "module",
  "bin": {
    "paradigma": "dist/paradigma.mjs"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "esbuild": "0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "zod": "^4.6.5"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
